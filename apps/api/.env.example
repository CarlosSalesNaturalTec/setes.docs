# apps/api — variáveis locais (produção injeta via Cloud Run + Secret Manager).
GCP_PROJECT_ID=setes-docs-prod
DATABASE_URL=postgresql+psycopg://app:senha@10.0.0.3:5432/setes
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=0
OIDC_AUDIENCE=https://api-xxxx.southamerica-east1.run.app
TASKS_INVOKER_SA_EMAIL=sa-tasks-invoker@setes-docs-prod.iam.gserviceaccount.com
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@setes.docs
JWT_SIGNING_KEY=
CLOUD_TASKS_LOCATION=southamerica-east1
CLOUD_TASKS_QUEUE=emails
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
